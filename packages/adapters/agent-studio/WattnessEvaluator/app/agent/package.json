{
  "name": "WattnessEvaluator-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Wattness evaluation seller agent for BNB Agent Studio: the sole signer and the evaluator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/vendor-evaluator.mjs",
    "dev": "tsx src/unifiedMain.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bnbagent/studio-runtime": "0.0.16",
    "@bnbagent/sdk": "0.6.1",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "express": "^5.1.0",
    "@a2a-js/sdk": ">=0.3.14 <1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "5.1.0"
  }
}
