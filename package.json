{
  "name": "gatelock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "plan": "pnpm -s build:agent && node packages/agent/dist/cli/plan.js",
    "commit": "pnpm -s build:agent && node contracts/scripts/commit.ts",
    "verify": "pnpm -s build:agent && node packages/verifier/dist/cli.js",
    "outcome": "pnpm -s build:agent && node packages/agent/dist/cli/outcome.js",
    "data:sync": "pnpm --filter @gatelock/data build && pnpm --filter @gatelock/data sync",
    "build:agent": "pnpm --filter @gatelock/agent... --filter @gatelock/verifier... build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
