# Copy to a file outside the repo and point GATE_SECRETS_ENV at it.
# Default: ~/Documents/wattness-secrets/bnb-bangkok.env, the only path scripts/greenfield reads.
# Install, test, verify and `pnpm plan --network local` read none of these.

# The record wallet: pnpm plan for a real chain, pnpm commit, pnpm outcome, contracts chain:deploy,
# chain:anchor, chain:commit and chain:balance (without --address), scripts/greenfield, and the funding
# and card upload in scripts/agents
GATE_PRIVATE_KEY=

# Optional, scripts/greenfield: an https BSC testnet RPC to use instead of the public one
BSC_TESTNET_RPC_URL=

# modules/flap scripts/season.ts and modules/openfour scripts/launch.ts (BSC testnet)
FLAP_TESTNET_PRIVATE_KEY=
OPENFOUR_TESTNET_PRIVATE_KEY=
OPENFOUR_TESTNET_ADDRESS=

# Live runners of packages/adapters/atlas-cmc, cournot (keyed client only) and living-brain
ATLAS_API_KEY=
CMC_PRO_API_KEY=
COURNOT_API_KEY=
LIVING_BRAIN_API_KEY=
LIVING_BRAIN_SUBJECT_ID=

# workers/edge scripts/deploy.ts: an API token with Account > Workers Scripts > Edit, and that account's ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# scripts/agents/wallets.ts appends AGENT_<ROLE>_PRIVATE_KEY and AGENT_<ROLE>_ADDRESS for the six roles.
