{
  "name": "@gatelock/edge",
  "private": true,
  "type": "module",
  "description": "A Cloudflare Worker that serves a sealed operating day's records from Greenfield, each file checked against GateRecord on BSC first",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.ts",
    "golden": "node scripts/golden.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "22.20.5",
    "canonicalize": "5.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
